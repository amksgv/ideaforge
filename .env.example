# ---------------------------------------------------------------------------
# IdeaForge environment
# Copy to `.env` and fill in only what you need. The app runs fully OFFLINE
# with zero keys (DATA_MODE=offline). Set DATA_MODE=live + keys to harvest
# real signals and synthesize reports with an LLM.
# ---------------------------------------------------------------------------

# SQLite database (local file). No server required.
DATABASE_URL="file:./dev.db"

# Pipeline mode: "offline" (deterministic fixtures + templated synthesis)
# or "live" (real collectors + LLM synthesis where keys are present).
DATA_MODE="offline"

# Shared secret for the daily cron endpoint (/api/cron/daily). The endpoint
# returns 503 until this is set. Generate one with: openssl rand -hex 32
CRON_SECRET=""

# --- LLM synthesis (only used when DATA_MODE=live, or for the Idea Agent) ---
# Provider: "openai" | "anthropic" | "none"
LLM_PROVIDER="none"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Signal collectors (only used when DATA_MODE=live) ---
# Reddit (https://www.reddit.com/prefs/apps -> create a "script" app)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="ideaforge/0.1 by your_username"

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=""

# Google Trends + keyword volume via SerpAPI (https://serpapi.com)
SERPAPI_KEY=""

# X/Twitter and Facebook Groups have no compliant free API — those collectors
# remain fixture-backed stubs even in live mode (see README).
