// IdeaForge data model.
// SQLite for zero-config local dev. In production this maps cleanly to
// Postgres/Supabase (swap the datasource provider + the driver adapter in
// src/lib/db.ts + DATABASE_URL in prisma.config.ts).
//
// SQLite has no native JSON type, so the rich nested report is stored as a
// JSON string in `report`, and a lightweight `summary` projection is stored
// alongside it so list/filter queries never hydrate full reports.
// Frequently-filtered/sorted fields are mirrored into real columns.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Idea {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  tagline       String
  category      String
  businessModel String
  emoji         String   @default("💡")

  // Mirrored scores for fast sort/filter. Dimensions keep one decimal
  // (Float) so ORDER BY matches what the UI displays; overall is 0-100 Int.
  overallScore     Int
  opportunityScore Float
  problemScore     Float
  feasibilityScore Float
  whyNowScore      Float

  // Mirrored business-fit / founder-fit facets for filtering.
  revenueLabel        String
  executionLabel      String
  founderInvestment   String // Low | Medium | High
  founderTechnical    String // Low | Medium | High
  founderTime         String

  gregsPick  Boolean @default(false)
  confidence Int     @default(70) // 0-100 pipeline confidence
  tags       String  @default("") // comma-separated, lowercased

  // Lowercased title + tagline + category + tags + narrative, for LIKE search
  // (swap for SQLite FTS5 / Postgres tsvector when the catalog grows).
  searchText String @default("")

  // IdeaSummary projection, JSON-encoded — what list views read.
  summary String @default("{}")
  // Full IdeaReport object, JSON-encoded — what the detail page reads.
  report  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features DailyFeature[]

  @@index([category])
  @@index([businessModel])
  @@index([overallScore])
  @@index([founderTechnical, founderInvestment])
}

// One Idea featured per UTC day → "Idea of the Day".
model DailyFeature {
  id     String @id @default(cuid())
  date   String @unique // YYYY-MM-DD (UTC)
  ideaId String
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([ideaId])
}
